<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="CrossBrowserSuite"
       parallel="tests"
       thread-count="2">

    <listeners>

        <listener class-name="utilities.RetryListener"/>

    </listeners>
  
    <test name="edgeTest">
        <parameter name="browser" value="edge"/>

        <classes>
            <class name="testCases.TC_LoginandUserManagementDemoWebShop"/>
        </classes>
    </test>
 
    <test name="ChromeTest">
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="testCases.TC_ECommerceAutomationDemoWebShop"/>
        </classes>
    </test>

</suite>